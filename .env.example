# 개발자 '각자의' dev 봇 토큰을 넣으세요.
# 같은 토큰을 두 사람이 동시에 실행하거나 운영 봇 토큰을 여기 넣으면,
# 게이트웨이 세션이 둘 붙어서 모든 버튼/명령이 두 번씩 처리됩니다 (점수 2배 지급).
# Discord Developer Portal에서 본인 전용 애플리케이션을 새로 만드세요.
DISCORD_TOKEN=your_discord_bot_token_here

# 본인 테스트 서버 ID. 넣으면 슬래시 명령어가 즉시 동기화됩니다.
# (비우면 전역 등록이라 반영까지 최대 1시간)
# 디스코드 서버 우클릭 -> 서버 ID 복사
GUILD_ID=

# 운영자 슬래시 명령어를 쓸 수 있는 역할 ID (쉼표 구분, 선택)
# 역할 우클릭 -> 역할 ID 복사
OPERATOR_ROLE_IDS=

# DB 위치 (선택). 비우면 저장소 안의 data/ 를 씁니다.
# 운영 서버는 systemd가 /var/lib/yumcbot/data 로 넘겨줍니다.
# YUMCBOT_DATA_DIR=
